<?xml version="1.0" encoding="utf-8"?>  <!-- Phải có XML prolog ngay đầu file, không có khoảng trắng nào trước nó :contentReference[oaicite:0]{index=0} -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
>
       

    <!-- Quyền truy cập -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>                  <!-- tools:ignore giờ hợp lệ nhờ namespace bên trên -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Queries: gom chung trong một khối, không được tách ra ngoài manifest root  -->
    <queries>
        <provider android:authorities="com.facebook.katana.provider.PlatformProvider"/>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

    <application
        android:requestLegacyExternalStorage="true"
        android:label="image_generator_app"
        android:icon="@mipmap/ic_launcher"
        android:name="${applicationName}"
        tools:replace="android:requestLegacyExternalStorage">  <!-- Ví dụ nếu cần override thư viện dùng attr này -->

        <!-- Metadata Facebook SDK -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id"/>
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|screenSize|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Flutter embedding version -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

</manifest>
